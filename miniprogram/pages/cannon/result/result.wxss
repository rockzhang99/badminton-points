/* pages/cannon/result/result.wxss */

/* MVP Banner */
.mvp-banner {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 40rpx;
  background: linear-gradient(180deg, rgba(0,117,74,0.06) 0%, var(--color-bg-primary) 100%);
}

.mvp-crown {
  font-size: 48rpx;
}

.mvp-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-gold);
  margin: 16rpx 0;
  background: var(--color-bg-card);
}

.mvp-name {
  color: var(--color-text-primary);
}

.mvp-score {
  margin: 8rpx 0;
  color: var(--color-brand);
  font-weight: 700;
}

.mvp-title {
  margin-top: 4rpx;
  color: var(--color-text-secondary);
}

/* 分数表 */
.section {
  margin-top: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  padding: 0 48rpx 16rpx;
  color: var(--color-text-primary);
}

.score-table {
  width: 100%;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.table-header {
  display: flex;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--color-border);
  background: var(--color-bg-secondary);
}

.table-header view {
  font-size: 22rpx;
  color: var(--color-text-hint);
  font-weight: 600;
}

.table-row {
  display: flex;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--color-bg-secondary);
  align-items: center;
}

.table-row:last-child {
  border-bottom: none;
}

.col-rank {
  width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.col-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.col-score {
  width: 80rpx;
  text-align: right;
  font-size: 30rpx;
  font-weight: 700;
}

.col-net {
  width: 80rpx;
  text-align: right;
  font-size: 28rpx;
}

.col-detail {
  width: 120rpx;
  text-align: right;
}

.row-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
  background: var(--color-bg-card);
}

/* 性别图标 */
.gender-icon {
  font-size: 20rpx;
  margin-left: 6rpx;
  flex-shrink: 0;
  color: var(--color-male);
}

.gender-f {
  color: var(--color-female);
}

/* 底部按钮 */
.footer-bar {
  padding: 32rpx 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.mr-16 { margin-right: 16rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-8 { margin-bottom: 8rpx; }
