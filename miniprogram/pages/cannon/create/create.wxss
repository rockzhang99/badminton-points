/* pages/cannon/create/create.wxss */

.play-info {
  border-left: 6rpx solid var(--color-brand);
}

.mode-icon {
  font-size: 52rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 600;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: var(--color-bg-secondary);
  border-radius: var(--radius-sm);
  padding: 0 20rpx;
  margin-top: 16rpx;
  color: var(--color-text-primary);
  font-size: 28rpx;
}

.member-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.member-item {
  width: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx;
  position: relative;
  border-radius: var(--radius-sm);
  background: var(--color-bg-secondary);
}

.member-item.selected {
  background: rgba(255, 90, 51, 0.15);
  border: 2rpx solid var(--color-brand);
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-bg-card);
}

.member-check {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--color-brand);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.footer-bar {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.btn-fire {
  width: 100%;
  height: 100rpx;
  font-size: 36rpx;
  letter-spacing: 4rpx;
}

.btn-fire.disabled {
  opacity: 0.4;
}
