/* pages/cannon/create/create.wxss */

/* 玩法信息卡 */
.page-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.page-section {
  margin-top: 24rpx;
}

.play-info {
  border-left: 4rpx solid var(--color-brand);
}

.mode-icon {
  font-size: 52rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 84rpx;
  background: var(--color-bg-secondary);
  border-radius: var(--radius-sm);
  padding: 0 24rpx;
  color: var(--color-text-primary);
  font-size: 28rpx;
  border: 1rpx solid transparent;
}

.form-input:focus {
  border-color: var(--color-brand);
  background: #fff;
}

.form-picker {
  width: 100%;
  height: 84rpx;
  background: var(--color-bg-secondary);
  border-radius: var(--radius-sm);
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  color: var(--color-text-primary);
  font-size: 28rpx;
  justify-content: space-between;
}

.form-picker text:last-child {
  color: var(--color-text-hint);
  font-size: 24rpx;
}

.member-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* 选手列表 */
.player-list {
  margin-top: 16rpx;
}

.player-item {
  display: flex;
  align-items: center;
  background: var(--color-bg-secondary);
  border-radius: var(--radius-sm);
  padding: 14rpx 18rpx;
  margin-bottom: 12rpx;
}

.player-index {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-brand);
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.player-input {
  flex: 1;
  height: 64rpx;
  margin-left: 16rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
  background: transparent;
}

/* 性别切换按钮 */
.gender-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #EFF6FF;
  color: #3B82F6;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 12rpx;
  border: 2rpx solid transparent;
}

.gender-btn.gender-female {
  background: #FDF2F8;
  color: #EC4899;
  border-color: #EC4899;
}

.player-remove {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(239, 68, 68, 0.08);
  color: var(--color-lose);
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.player-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.btn-add-player,
.btn-import-player {
  flex: 1;
  height: 76rpx;
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  line-height: 76rpx;
}

.btn-add-player::after,
.btn-import-player::after { border: none; }

.btn-add-player {
  background: var(--color-brand);
}

.btn-add-player[disabled] {
  opacity: 0.4;
}

.btn-import-player {
  background: var(--color-male);
}

.player-stats {
  line-height: 1.6;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

/* 导入弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
}

.import-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 640rpx;
  max-height: 80vh;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  z-index: 101;
  box-shadow: var(--shadow-lg);
  display: none;
}

.import-modal.show {
  display: flex;
  flex-direction: column;
}

.import-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--color-border);
  flex-shrink: 0;
}

.import-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.import-modal-close {
  width: 48rpx;
  height: 48rpx;
  font-size: 36rpx;
  color: var(--color-text-hint);
  display: flex;
  align-items: center;
  justify-content: center;
}

.import-modal-body {
  padding: 24rpx 28rpx;
  flex: 1;
  overflow-y: auto;
  min-height: 0;
}

.import-toolbar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.import-btn-paste,
.import-btn-clear {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  background: var(--color-bg-secondary);
  color: var(--color-text-primary);
}

.import-textarea {
  width: 100%;
  min-height: 200rpx;
  max-height: 280rpx;
  background: var(--color-bg-secondary);
  border-radius: var(--radius-sm);
  padding: 20rpx;
  font-size: 26rpx;
  color: var(--color-text-primary);
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.import-modal-footer {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx 28rpx;
  border-top: 1rpx solid var(--color-border);
  flex-shrink: 0;
}

.btn-cancel,
.btn-confirm-import,
.btn-confirm-all {
  flex: 1;
  height: 72rpx;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  line-height: 72rpx;
}

.btn-cancel::after,
.btn-confirm-import::after,
.btn-confirm-all::after { border: none; }

.btn-cancel {
  background: var(--color-bg-secondary);
  color: var(--color-text-secondary);
}

.btn-confirm-import {
  font-weight: 600;
  background: var(--color-brand);
  color: #fff;
}

.btn-confirm-all {
  background: var(--color-male);
  color: #fff;
  font-weight: 600;
}

/* 队员选择 */
.member-item {
  width: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx;
  position: relative;
  border-radius: var(--radius-sm);
  background: var(--color-bg-secondary);
}

.member-item.selected {
  background: rgba(0, 117, 74, 0.08);
  border: 2rpx solid var(--color-brand);
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-bg-card);
}

.member-check {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--color-brand);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 底部按钮 */
.footer-bar {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 比赛规则 */
.rules-list {
  margin-top: 8rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  padding: 6rpx 0;
}

.rule-dot {
  color: var(--color-brand);
  font-weight: bold;
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.rule-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.btn-fire {
  width: 100%;
  height: 100rpx;
  font-size: 36rpx;
  letter-spacing: 4rpx;
  background: var(--color-brand);
  color: #fff;
  border: none;
  border-radius: var(--radius-sm);
}

.btn-fire::after { border: none; }
.btn-fire.disabled {
  opacity: 0.4;
}
