<!-- pages/cannon/create/create.wxml -->
<view class="page">

  <!-- 玩法卡片 -->
  <view class="card play-info">
    <view class="flex">
      <view class="mode-icon">{{playModeConfig.icon}}</view>
      <view class="flex-1 ml-16">
        <view class="text-lg text-bold">{{playModeConfig.name}}</view>
        <view class="text-sm text-secondary mt-8">{{playModeConfig.desc}}</view>
      </view>
    </view>
    <view class="text-xs text-hint mt-16">
      {{playModeConfig.minPlayers}}-{{playModeConfig.maxPlayers}}人
    </view>
  </view>

  <!-- 比赛名称 -->
  <view class="card">
    <view class="form-label">比赛名称</view>
    <input
      class="form-input"
      value="{{gameName}}"
      placeholder="输入比赛名称"
      maxlength="30"
      bindinput="onNameInput"
    />
  </view>

  <!-- 输入选手昵称 -->
  <view class="card">
    <view class="flex mb-24">
      <view class="form-label">🏸 输入选手昵称</view>
      <text class="text-sm text-hint ml-8">（{{playModeConfig.minPlayers}}-{{playModeConfig.maxPlayers}}人）</text>
    </view>

    <!-- 选手列表 -->
    <view class="player-list">
      <view class="player-item" wx:for="{{players}}" wx:key="id">
        <view class="player-index">{{index + 1}}</view>
        <input
          class="player-input"
          value="{{item.nickname}}"
          placeholder="请输入选手{{index + 1}}昵称"
          maxlength="10"
          data-index="{{index}}"
          bindinput="onPlayerInput"
        />
        <view
          class="gender-btn {{item.gender === 2 ? 'gender-female' : ''}}"
          data-index="{{index}}"
          bindtap="onGenderToggle"
        >{{item.gender === 2 ? '♀' : '♂'}}</view>
        <view class="player-remove" wx:if="{{players.length > playModeConfig.minPlayers}}" data-index="{{index}}" bindtap="onRemovePlayer">×</view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="player-actions">
      <button class="btn-add-player" disabled="{{players.length >= playModeConfig.maxPlayers}}" bindtap="onAddPlayer">+ 添加选手</button>
      <button class="btn-import-player" bindtap="onShowImportModal">📥 从报名导入</button>
    </view>

    <!-- 统计信息 -->
    <view class="player-stats text-xs text-hint mt-24">
      当前选手：<text class="text-brand">{{players.length}}</text>人
      <text class="ml-24" wx:if="{{players.length >= playModeConfig.minPlayers}}">
        ，每人参赛场次：<text class="text-brand">{{matchCountPerPlayer}}</text>场
      </text>
      <text class="ml-24" wx:if="{{totalMatches > 0}}">
        ，比赛场数：<text class="text-brand">{{totalMatches}}</text>场
      </text>
    </view>
  </view>

  <!-- 从报名导入弹窗 -->
  <view class="modal-mask" wx:if="{{showImportModal}}" bindtap="onHideImportModal"></view>
  <view class="import-modal {{showImportModal ? 'show' : ''}}">
    <view class="import-modal-header">
      <text class="import-modal-title">📥 从报名信息导入</text>
      <view class="import-modal-close" bindtap="onHideImportModal">×</view>
    </view>

    <view class="import-modal-body">
      <view class="form-label mb-16">报名信息文本</view>
      <view class="import-toolbar">
        <view class="import-btn-paste" bindtap="onPasteClipboard">📋 粘贴</view>
        <view class="import-btn-clear" bindtap="onClearImportText">🗑 清除</view>
      </view>
      <textarea
        class="import-textarea"
        value="{{importText}}"
        placeholder="请粘贴闪动或微信接龙完整报名信息&#10;（如：1.【3.0】FEI 🍃&#10;或 1. FEI）"
        maxlength="2000"
        auto-height
        bindinput="onImportTextInput"
      />
    </view>

    <view class="import-modal-footer">
      <button class="btn-cancel" bindtap="onHideImportModal">取消</button>
      <button class="btn-confirm-import" bindtap="onImportPlayers">顺序添加</button>
      <button class="btn-confirm-import btn-confirm-all" bindtap="onConfirmImport">确认添加</button>
    </view>
  </view>

  <!-- 比赛规则 -->
  <view class="card" wx:if="{{playModeRules.length > 0}}">
    <view class="form-label">📋 比赛规则</view>
    <view class="rules-list">
      <view class="rule-item" wx:for="{{playModeRules}}" wx:key="index">
        <text class="rule-dot">•</text>
        <text class="rule-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 开炮按钮 -->
  <view class="footer-bar">
    <button
      class="btn-cannon btn-fire {{canStart ? '' : 'disabled'}}"
      bindtap="onFire"
      disabled="{{!canStart}}"
    >
      🚀 开炮组局！
    </button>
  </view>

</view>
