<!-- pages/cannon/scoring/scoring.wxml -->
<wxs module="utils" src="./scoring.wxs"></wxs>

<view class="page">

  <!-- 顶部进度条 -->
  <view class="progress-bar">
    <view class="progress-fill" style="width: {{progress}}%"></view>
    <view class="progress-text text-xs text-secondary">
      第 {{currentCourt + 1}} / {{totalCount}} 场
    </view>
  </view>

  <!-- 场地 Swiper -->
  <swiper
    class="court-swiper"
    current="{{currentCourt}}"
    bindchange="onCourtChange"
    indicator-dots="{{true}}"
    indicator-color="rgba(0,0,0,0.1)"
    indicator-active-color="#00754A"
  >
    <swiper-item wx:for="{{matches}}" wx:key="index" wx:if="{{item.teamA.length && item.teamB.length}}">
      <view class="court-page">

        <!-- 场地编号 + 轮次 -->
        <view class="court-header">
          <view class="tag-cannon">第 {{item.round}} 轮 · 场 {{item.court}}</view>
          <view class="text-sm {{item.status === 'finished' ? 'text-win' : 'text-brand'}}">
            {{item.status === 'finished' ? '已结束' : item.status === 'playing' ? '进行中' : '待开始'}}
          </view>
        </view>

        <!-- ===== 对阵信息卡（参照左图）===== -->
        <view class="match-info-card">
        <!-- 上排：选手位置 -->
        <view class="pos-row">
          <view class="pos-side">
            <text class="pos-tag">左</text>
            <text class="pos-score-sm">{{item.scoreA}}</text>
            <view class="pos-name-wrap">
              <text class="pos-name">{{teamAName0}}</text>
              <text class="gender-icon {{teamAGender0 === 2 ? 'gender-f' : ''}}">{{teamAGender0 === 2 ? '♀' : '♂'}}</text>
            </view>
          </view>
          <view class="vs-badge">VS</view>
          <view class="pos-side pos-right">
            <view class="pos-name-wrap">
              <text class="pos-name">{{teamBName0}}</text>
              <text class="gender-icon {{teamBGender0 === 2 ? 'gender-f' : ''}}">{{teamBGender0 === 2 ? '♀' : '♂'}}</text>
            </view>
            <text class="pos-score-sm">{{item.scoreB}}</text>
            <text class="pos-tag">右</text>
          </view>
        </view>

          <!-- 交换箭头行 -->
          <view class="swap-row">
            <view class="swap-arrow">⇅</view>
            <view class="swap-hint">⇄</view>
            <view class="swap-arrow">⇅</view>
          </view>

        <!-- 下排：第二位选手位置（双打时显示）-->
        <view class="pos-row" wx:if="{{teamAName1 || teamBName1}}">
          <view class="pos-side">
            <text class="pos-tag">右</text>
            <text class="pos-score-sm">{{item.scoreA}}</text>
            <view class="pos-name-wrap">
              <text class="pos-name">{{teamAName1}}</text>
              <text class="gender-icon {{teamAGender1 === 2 ? 'gender-f' : ''}}" wx:if="{{teamAName1}}">{{teamAGender1 === 2 ? '♀' : '♂'}}</text>
            </view>
          </view>
          <view class="vs-blank"></view>
          <view class="pos-side pos-right">
            <view class="pos-name-wrap">
              <text class="pos-name">{{teamBName1}}</text>
              <text class="gender-icon {{teamBGender1 === 2 ? 'gender-f' : ''}}" wx:if="{{teamBName1}}">{{teamBGender1 === 2 ? '♀' : '♂'}}</text>
            </view>
            <text class="pos-score-sm">{{item.scoreB}}</text>
            <text class="pos-tag">左</text>
          </view>
        </view>

          <!-- 发球指示 -->
          <view class="serve-badge {{servingSide === 'right' ? 'serve-right' : ''}}">
            {{servingSide === 'right' ? '右边发球' : '左边发球'}}
          </view>
        </view>

        <!-- ===== 计分板 + 比分调节（参照左图）===== -->
        <view class="scoreboard-card">
          <!-- 大号比分 -->
          <view class="big-scores">
            <view class="big-num {{item.winner === 'A' ? 'text-win' : ''}}">{{item.scoreA}}</view>
            <view class="big-colon">:</view>
            <view class="big-num {{item.winner === 'B' ? 'text-win' : ''}}">{{item.scoreB}}</view>
          </view>

          <!-- ± 按钮 -->
          <view class="pm-buttons" wx:if="{{item.status !== 'finished'}}">
            <button class="pm-btn pm-minus" bindtap="onMinusA">−</button>
            <button class="pm-btn pm-plus" bindtap="onAddA">+</button>
            <button class="pm-btn pm-minus" bindtap="onMinusB">−</button>
            <button class="pm-btn pm-plus" bindtap="onAddB">+</button>
          </view>
        </view>

        <!-- ===== 快速比分（参照左图）===== -->
        <view class="quick-section" wx:if="{{item.status !== 'finished'}}">
          <view class="section-label">快速比分</view>
          <view class="quick-btns">
            <button class="quick-btn" bindtap="onQuickScore" data-a="21" data-b="15">21 - 15</button>
            <button class="quick-btn" bindtap="onQuickScore" data-a="15" data-b="21">15 - 21</button>
          </view>
        </view>

        <!-- ===== 操作按钮行 ===== -->
        <view class="action-row" wx:if="{{item.status !== 'finished'}}">
          <button class="action-btn action-reset" bindtap="onResetScore">重置</button>
          <button class="action-btn action-next" bindtap="onNextCourt">下一场 →</button>
        </view>

        <!-- 已结束标记 -->
        <view class="finished-badge" wx:if="{{item.status === 'finished'}}">
          <view class="badge-text text-win text-bold">🏆 {{item.winner === 'A' ? 'A队' : 'B队'}} 获胜</view>
          <!-- 已结束时也显示操作按钮 -->
          <view class="action-row mt-24">
            <button class="action-btn action-save" bindtap="onReopenMatch">重新开打</button>
          </view>
        </view>

      </view>
    </swiper-item>
  </swiper>

  <!-- 底部：全部结束 -->
  <view class="footer-bar">
    <button class="btn-cannon full-width" bindtap="onFinishAll">
      🚀 结束全部比赛，查看炮分
    </button>
  </view>

</view>
