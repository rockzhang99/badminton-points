/* pages/leaderboard/total/total.wxss */

.tab-bar {
  background: var(--color-bg-card);
  padding: 6rpx;
  margin: 16rpx 24rpx;
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-sm);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  border-radius: 6rpx;
  transition: all 0.2s;
  font-weight: 500;
}

.tab-item.active {
  background: var(--color-brand);
  color: #fff;
  font-weight: 600;
}

/* 排行列表 */
.rank-list {
  padding: 8rpx 24rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 20rpx 20rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  margin-bottom: 12rpx;
  box-shadow: var(--shadow-sm);
}

.rank-item:first-child {
  border: 1rpx solid rgba(212, 168, 83, 0.4);
  box-shadow: var(--shadow-md);
}

.rank-number {
  width: 60rpx;
  text-align: center;
  flex-shrink: 0;
}

.rank-medal {
  font-size: 36rpx;
}

.rank-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-bg-secondary);
  flex-shrink: 0;
}

.rank-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

.rank-score {
  text-align: right;
  flex-shrink: 0;
}

.ml-16 { margin-left: 16rpx; }
.mt-4 { margin-top: 4rpx; }

.loading {
  padding: 200rpx 0;
  text-align: center;
  color: var(--color-text-hint);
}

/* 性别图标 */
.gender-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}
.gender-icon-female { color: #EC4899; }
.gender-icon-male { color: #3B82F6; }
