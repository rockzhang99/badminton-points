<!-- pages/leaderboard/total/total.wxml -->
<view class="page">

  <!-- Tab 切换 -->
  <view class="tab-bar flex">
    <view
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="switchTab"
    >
      {{item.label}}
    </view>
  </view>

  <!-- 排行榜列表 -->
  <view class="rank-list" wx:if="{{!loading}}">
    <view
      class="rank-item"
      wx:for="{{rankList}}"
      wx:key="memberId"
    >
      <!-- 排名 -->
      <view class="rank-number">
        <text wx:if="{{item.rank === 1}}" class="rank-medal">🥇</text>
        <text wx:elif="{{item.rank === 2}}" class="rank-medal">🥈</text>
        <text wx:elif="{{item.rank === 3}}" class="rank-medal">🥉</text>
        <text wx:else class="text-hint text-md">#{{item.rank}}</text>
      </view>

      <!-- 头像 -->
      <image
        wx:if="{{item.avatarUrl}}"
        class="rank-avatar"
        src="{{item.avatarUrl}}"
        mode="aspectFill"
      />
      <view
        wx:else
        class="rank-avatar rank-avatar-default"
        style="background-color: {{item.avatarColor || '#4CAF50'}};"
      >
        {{item.nickname[0] || '?'}}
      </view>

      <!-- 信息 -->
      <view class="flex-1 ml-16">
        <view class="text-md text-bold">{{item.nickname}}</view>
        <view class="text-xs text-hint mt-4">
          {{item.gamesPlayed}}场 · 胜率{{item.winRate}}%
        </view>
      </view>

      <!-- 炮分 -->
      <view class="rank-score">
        <text class="text-brand text-lg text-bold">{{item.score}}</text>
        <text class="text-xs text-hint"> 炮分</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{rankList.length === 0}}">
      <view class="empty-icon">🏆</view>
      <view class="empty-text">还没有炮局<br/>快让章一炮开一炮！</view>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <view class="empty-text text-hint">炮分加载中...</view>
  </view>

</view>
