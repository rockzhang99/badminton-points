<!-- pages/mine/badges/badges.wxml -->
<view class="page">

  <view class="section-title">🏅 炮徽章</view>

  <view class="badge-grid">
    <view class="card badge-card text-center" wx:for="{{badges}}" wx:key="type">
      <view class="badge-icon-wrap {{item.earned ? 'earned' : 'locked'}}">
        <view class="badge-emoji">{{item.icon}}</view>
      </view>
      <view class="text-md text-bold mt-16 {{item.earned ? '' : 'text-hint'}}">{{item.name}}</view>
      <view class="text-xs {{item.earned ? 'text-secondary' : 'text-hint'}} mt-4">{{item.desc}}</view>
      <view class="tag-cannon mt-8" wx:if="{{item.earned}}">已获得</view>
      <view class="text-xs text-hint mt-8" wx:else>未解锁</view>
    </view>
  </view>

</view>
