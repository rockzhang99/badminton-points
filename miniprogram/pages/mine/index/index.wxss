/* pages/mine/index/index.wxss */

.user-header {
  display: flex; flex-direction: column; align-items: center;
  padding: 60rpx 32rpx 40rpx;
  background: linear-gradient(180deg, rgba(0,117,74,0.06) 0%, var(--color-bg-primary) 100%);
}

.user-avatar {
  width: 140rpx; height: 140rpx; border-radius: 50%;
  border: 3rpx solid var(--color-brand);
  background: var(--color-bg-card);
}

.user-name { color: var(--color-text-primary); font-weight: 600; }

.avatar-placeholder {
  width: 140rpx; height: 140rpx; border-radius: 50%;
  background: var(--color-bg-card);
  display: flex; align-items: center;
  justify-content: center; font-size: 60rpx;
  border: 3rpx solid var(--color-border);
}

.avatar-btn { background: none; padding: 0; margin: 0; border: none; }
.avatar-btn::after { border: none; }

.stats-card {
  margin-top: -20rpx; position: relative; z-index: 1;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  margin: -20rpx 24rpx 0;
  box-shadow: var(--shadow-sm);
}

.stat-item { padding: 16rpx 0; }

.menu-section {
  margin: 24rpx 24rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--color-bg-card);
  box-shadow: var(--shadow-sm);
}

.menu-item {
  padding: 28rpx 24rpx; font-size: 28rpx; color: var(--color-text-primary);
  border-bottom: 1rpx solid var(--color-bg-secondary);
}

.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: var(--color-bg-card-hover); }

.footer-section {
  padding: 40rpx 48rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.btn-clear {
  background: rgba(239,68,68,0.06); color: var(--color-lose); border: none;
  font-size: 24rpx; padding: 20rpx; border-radius: var(--radius-sm);
}

.btn-clear::after { border: none; }
.btn-clear:active { background: rgba(239,68,68,0.12); }

.mt-16 { margin-top: 16rpx; }
.mt-4 { margin-top: 4rpx; }
