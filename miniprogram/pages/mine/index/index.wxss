/* pages/mine/index/index.wxss */

.user-header {
  display: flex; flex-direction: column; align-items: center;
  padding: 60rpx 32rpx 40rpx;
  background: linear-gradient(180deg, rgba(255,90,51,0.15) 0%, transparent 100%);
}

.user-avatar { width: 140rpx; height: 140rpx; border-radius: 50%; border: 4rpx solid var(--color-brand); background: var(--color-bg-card); }
.user-name { color: var(--color-text-primary); }

.avatar-placeholder {
  width: 140rpx; height: 140rpx; border-radius: 50%;
  background: var(--color-bg-card); display: flex; align-items: center;
  justify-content: center; font-size: 60rpx;
}

.avatar-btn { background: none; padding: 0; margin: 0; border: none; }
.avatar-btn::after { border: none; }

.stats-card { margin-top: -20rpx; position: relative; z-index: 1; }

.stat-item { padding: 16rpx 0; }

.menu-section {
  margin: 24rpx 24rpx; border-radius: var(--radius-md);
  overflow: hidden; background: var(--color-bg-card);
}

.menu-item {
  padding: 28rpx 24rpx; font-size: 28rpx; color: var(--color-text-primary);
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}

.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: var(--color-bg-card-hover); }

.footer-section { padding: 40rpx 48rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }

.btn-clear {
  background: rgba(255,82,82,0.1); color: var(--color-lose); border: none;
  font-size: 24rpx; padding: 20rpx; border-radius: var(--radius-sm);
}

.btn-clear::after { border: none; }

.mt-16 { margin-top: 16rpx; }
.mt-4 { margin-top: 4rpx; }
