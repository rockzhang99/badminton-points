<!-- pages/index/index.wxml -->
<view class="page">

  <!-- 顶部 Slogan -->
  <view class="hero">
    <view class="hero-title">🚀 球局计分器</view>
    <view class="hero-slogan">{{cannonSlogan}}</view>
  </view>

  <!-- 玩法选择卡片 - 彩色网格 -->
  <view class="section">
    <view class="section-title">创建比赛模式</view>
    <view class="mode-grid" wx:if="{{playModes.length}}">
      <view
        class="grid-card card-{{index % 6}}"
        wx:for="{{playModes}}"
        wx:key="mode"
        data-mode="{{item.mode}}"
        bindtap="onSelectMode"
      >
        <view class="grid-card-inner">
          <view class="grid-icon-wrap">
            <text class="grid-icon">{{item.icon}}</text>
          </view>
          <view class="grid-text">
            <view class="grid-name">{{item.name}}</view>
            <view class="grid-sub">{{item.descShort || item.desc}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 最近比赛 -->
  <view class="section">
    <view class="section-header flex-between">
      <view class="section-title">历史记录</view>
      <view class="section-more" bindtap="onViewHistory">查看全部 ›</view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{showEmpty}}">
      <view class="empty-icon">🎯</view>
      <view class="empty-text">
        暂无比赛记录，点击上方创建新
      </view>
    </view>

    <!-- 最近比赛列表 -->
    <view class="recent-list" wx:else>
      <view
        class="card recent-item"
        wx:for="{{recentGames}}"
        wx:key="_id"
        data-id="{{item._id}}"
        bindtap="onViewDetail"
      >
        <view class="flex-1">
          <view class="text-md text-bold">{{item.name}} <text class="text-sm text-hint text-normal" wx:if="{{item.timeShort}}">{{item.timeShort}}</text></view>
          <view class="text-sm text-secondary mt-8">
            {{item.players.length}}人 · {{item.playModeName || item.playMode}}
          </view>
        </view>
        <view class="text-brand text-lg">›</view>
      </view>
    </view>
  </view>

</view>
