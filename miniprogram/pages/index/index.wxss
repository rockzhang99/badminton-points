/* pages/index/index.wxss */
.hero {
  padding: 60rpx 48rpx 40rpx;
  text-align: center;
  background: linear-gradient(180deg, #FF5A33 0%, #0A1628 100%);
}

.hero-title {
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 4rpx 12rpx rgba(255, 90, 51, 0.5);
}

.hero-slogan {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 12rpx;
  letter-spacing: 4rpx;
}

.section {
  margin-top: 32rpx;
}

.section-header {
  padding: 0 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}

.section-more {
  font-size: 24rpx;
  color: var(--color-brand);
}

/* ============================================
   玩法网格 - 彩色卡片（参考羽毛球工具风格）
   ============================================ */
.mode-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 24rpx;
  justify-content: space-between;
}

.grid-card {
  width: calc(50% - 12rpx);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.2);
}

.grid-card:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.grid-card-inner {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
}

.grid-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.grid-icon {
  font-size: 40rpx;
}

.grid-text {
  flex: 1;
  min-width: 0;
}

.grid-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6rpx;
}

.grid-sub {
  font-size: 22rpx;
  color: rgba(255,255,255,0.82);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 6 种渐变色 - 每张卡片不同 */
.card-0 { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
.card-1 { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); }
.card-2 { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); }
.card-3 { background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); }
.card-4 { background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); }
.card-5 { background: linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%); }

/* 最近比赛 */
.recent-list {
  padding: 0 24rpx;
}

.recent-item {
  margin-bottom: 12rpx;
}

.recent-item:active {
  background: var(--color-bg-card-hover);
}
