/* pages/index/index.wxss */

/* 头部品牌区 */
.hero {
  padding: 60rpx 48rpx 40rpx;
  text-align: center;
  background: linear-gradient(180deg, rgba(0,117,74,0.06) 0%, var(--color-bg-primary) 100%);
}

.hero-title {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--color-text-primary);
  letter-spacing: 2rpx;
}

.hero-slogan {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-top: 12rpx;
  letter-spacing: 4rpx;
}

.section {
  margin-top: 32rpx;
}

.section-header {
  padding: 0 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}

.section-more {
  font-size: 24rpx;
  color: var(--color-brand);
}

/* 玩法网格 - 彩色卡片 */
.mode-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 24rpx;
  justify-content: space-between;
}

.grid-card {
  width: calc(50% - 12rpx);
  border-radius: var(--radius-lg);
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-md);
}

.grid-card:active {
  opacity: 0.92;
  transform: scale(0.98);
}

.grid-card-inner {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
}

.grid-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.grid-icon {
  font-size: 40rpx;
}

.grid-text {
  flex: 1;
  min-width: 0;
}

.grid-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6rpx;
}

.grid-sub {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 6 种卡片渐变色 */
.card-0 { background: #00754A; }
.card-1 { background: #2D8A6E; }
.card-2 { background: #059669; }
.card-3 { background: #4A90A4; }
.card-4 { background: #6B8E6B; }
.card-5 { background: #3A7D6E; }

/* 最近比赛 */
.recent-list {
  padding: 0 24rpx;
}

.recent-item {
  margin-bottom: 12rpx;
}

.recent-item:active {
  background: var(--color-bg-card-hover);
}
