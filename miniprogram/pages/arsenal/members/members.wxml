<!-- pages/arsenal/members/members.wxml -->
<view class="page">

  <view class="section-title flex-between">
    <text>👥 队员管理 ({{members.length}}人)</text>
    <view class="btn-cannon text-xs p-16" bindtap="showAddForm">+ 添加队员</view>
  </view>

  <!-- 队员列表 -->
  <view class="member-list">
    <view class="card member-card flex-between" wx:for="{{members}}" wx:key="_id">
      <view class="flex flex-1">
        <image class="member-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
        <view class="ml-16">
          <view class="text-md text-bold">
            {{item.nickname}}
            <text class="text-xs {{item.gender === 1 ? 'text-male' : 'text-female'}}">
              {{item.gender === 1 ? '♂' : '♀'}}
            </text>
            <text class="tag-cannon text-xs" wx:if="{{item.isCannonFodder}}">炮灰</text>
          </view>
          <view class="text-xs text-hint mt-4">
            总炮分 {{item.stats.totalScore}} · {{item.stats.totalGames}}场 · 炮王×{{item.stats.cannonKingCount}}
          </view>
        </view>
      </view>
      <view class="flex">
        <view class="btn-secondary text-xs p-16 mr-8" data-id="{{item._id}}" catchtap="toggleCannonFodder">
          {{item.isCannonFodder ? '取消' : '炮灰'}}
        </view>
        <view class="btn-secondary text-xs p-16" data-id="{{item._id}}" catchtap="deleteMember">
          删除
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{members.length === 0}}">
      <view class="empty-icon">👥</view>
      <view class="empty-text">还没有队员<br/>点击右上角添加吧</view>
    </view>
  </view>

  <!-- 炮灰粉碎 -->
  <view class="footer-section">
    <button class="btn-clear" bindtap="onClearData">💣 炮灰粉碎（清除本地数据）</button>
  </view>

  <!-- 添加队员弹窗 -->
  <view class="overlay" wx:if="{{showAdd}}" bindtap="hideAddForm">
    <view class="add-panel" catchtap="noop">
      <view class="text-lg text-bold text-center mb-24">添加炮手</view>
      <input class="form-input mb-24" value="{{newName}}" placeholder="输入昵称" bindinput="onNameInput" maxlength="12" />
      <view class="flex-center mb-24">
        <view class="gender-btn {{newGender === 1 ? 'active' : ''}}" data-gender="1" bindtap="onGenderSelect">♂ 男</view>
        <view class="gender-btn {{newGender === 2 ? 'active' : ''}}" data-gender="2" bindtap="onGenderSelect">♀ 女</view>
      </view>
      <view class="flex">
        <button class="btn-secondary flex-1 mr-16" bindtap="hideAddForm">取消</button>
        <button class="btn-cannon flex-1" bindtap="addMember">确认添加</button>
      </view>
    </view>
  </view>

</view>
