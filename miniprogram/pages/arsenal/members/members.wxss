/* pages/arsenal/members/members.wxss */

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  padding: 24rpx;
  color: var(--color-text-primary);
}

.member-list {
  padding: 0 24rpx;
}

.member-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  margin-bottom: 12rpx;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.member-card:active { background: var(--color-bg-card-hover); }

.member-avatar {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: var(--color-bg-secondary); flex-shrink: 0;
}

.text-male { color: var(--color-male); }
.text-female { color: var(--color-female); }

.mr-8 { margin-right: 8rpx; }
.ml-16 { margin-left: 16rpx; }
.mt-4 { margin-top: 4rpx; }
.mb-24 { margin-bottom: 24rpx; }
.p-16 { padding: 16rpx; }

.overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4); display: flex; align-items: center;
  justify-content: center; z-index: 1000;
}

.add-panel {
  width: 560rpx; background: var(--color-bg-card);
  border-radius: var(--radius-lg); padding: 40rpx 32rpx;
  box-shadow: var(--shadow-lg);
}

.form-input {
  width: 100%; height: 80rpx; background: var(--color-bg-secondary);
  border-radius: var(--radius-sm); padding: 0 20rpx; color: var(--color-text-primary);
  font-size: 28rpx;
  border: 1rpx solid transparent;
}

.form-input:focus {
  border-color: var(--color-brand);
  background: #fff;
}

.gender-btn {
  flex: 1; text-align: center; padding: 16rpx; border-radius: var(--radius-sm);
  margin: 0 8rpx; background: var(--color-bg-secondary); color: var(--color-text-secondary);
  font-size: 28rpx;
}

.gender-btn.active {
  background: var(--color-brand);
  color: #fff;
}

.footer-section {
  padding: 40rpx 48rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.btn-clear {
  background: rgba(239,68,68,0.06); color: var(--color-lose); border: none;
  font-size: 24rpx; padding: 20rpx; border-radius: var(--radius-sm);
  width: 100%;
}

.btn-clear::after { border: none; }
.btn-clear:active { background: rgba(239,68,68,0.12); }
