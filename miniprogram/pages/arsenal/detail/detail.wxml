<!-- pages/arsenal/detail/detail.wxml -->
<view class="page" wx:if="{{game}}">

  <!-- 比赛头部 -->
  <view class="card detail-header">
    <view class="text-lg text-bold">{{game.name}}</view>
    <view class="flex mt-16">
      <view class="tag-cannon mr-8">{{game.playMode}}</view>
      <view class="tag-cannon">炮重 ×{{game.cannonWeight}}</view>
    </view>
    <view class="text-xs text-hint mt-8">{{game.players.length}}人 · {{game.matches.length}}场</view>
  </view>

  <!-- 炮分排名 -->
  <view class="section-title">本场炮分</view>
  <view class="card" style="padding:0;">
    <view class="detail-score-row" wx:for="{{scoreEntries}}" wx:key="memberId">
      <view class="detail-rank">
        <text wx:if="{{item.rank === 1}}">🥇</text>
        <text wx:elif="{{item.rank === 2}}">🥈</text>
        <text wx:elif="{{item.rank === 3}}">🥉</text>
        <text wx:else class="text-hint">{{item.rank}}</text>
      </view>
      <view class="flex-1 text-md">{{item.name}}</view>
      <view class="text-brand text-lg text-bold">{{item.score}}</view>
    </view>
  </view>

  <!-- 对阵详情 -->
  <view class="section-title">对阵记录</view>
  <view class="match-detail-card" wx:for="{{game.matches}}" wx:key="index"
    wx:if="{{item.status === 'finished'}}">
    <view class="text-xs text-hint mb-16">第 {{item.round}} 轮 · 场 {{item.court}}</view>
    <view class="flex-center">
      <view class="text-md text-center flex-1">
        <view wx:for="{{item.teamA}}" wx:key="*this">{{item}}</view>
      </view>
      <view class="detail-score">
        <text class="text-xl text-bold {{item.winner === 'A' ? 'text-win' : ''}}">{{item.scoreA}}</text>
        <text class="text-secondary mx-16">:</text>
        <text class="text-xl text-bold {{item.winner === 'B' ? 'text-win' : ''}}">{{item.scoreB}}</text>
      </view>
      <view class="text-md text-center flex-1">
        <view wx:for="{{item.teamB}}" wx:key="*this">{{item}}</view>
      </view>
    </view>
    <view class="text-xs text-hint text-center mt-8" wx:if="{{item.cannonEvents.length}}">
      💥 {{item.cannonEvents.length}}次炮击
    </view>
  </view>

  <view class="footer-bar">
    <button class="btn-cannon full-width" bindtap="onReplay">🔄 重新开炮</button>
  </view>

</view>
