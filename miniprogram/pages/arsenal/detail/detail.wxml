<!-- pages/arsenal/detail/detail.wxml -->
<view class="page" wx:if="{{game}}">

  <!-- 比赛头部 -->
  <view class="card detail-header">
    <view class="text-lg text-bold">{{game.name}}</view>
    <view class="flex mt-16">
      <view class="tag-cannon">{{modeDisplayName}}</view>
    </view>
    <view class="text-xs text-hint mt-8">{{playerCount}}人 · {{totalMatches}}场</view>
  </view>

  <!-- Tab 栏（排名 / 对阵） -->
  <view class="tab-bar card">
    <view
      class="tab-item {{activeTab === 'rank' ? 'tab-active' : ''}}"
      data-tab="rank"
      bindtap="onSwitchTab"
    >排名</view>
    <view
      class="tab-item {{activeTab === 'matches' ? 'tab-active' : ''}}"
      data-tab="matches"
      bindtap="onSwitchTab"
    >对阵</view>
  </view>

  <!-- ===== 排名 Tab ===== -->
  <block wx:if="{{activeTab === 'rank'}}">

    <!-- 固定搭模式：搭档排名表 -->
    <block wx:if="{{isBlindCannon}}">
      <view class="rank-table card">
        <view class="rank-header">
          <view class="col-name">参赛选手</view>
          <view class="col-pts">积分</view>
          <view class="col-wl">胜-负</view>
          <view class="col-net">净胜分</view>
          <view class="col-rank">名次</view>
        </view>
        <view class="rank-row" wx:for="{{pairEntries}}" wx:key="id">
          <view class="col-name">
            <view class="name-cell name-cell-pair">
              <text class="pair-player-name">{{item.player1Name}}</text>
              <text class="gender-icon {{item.player1Gender === 2 ? 'gender-icon-female' : 'gender-icon-male'}}">{{item.player1Gender === 2 ? '♀' : '♂'}}</text>
              <text class="pair-amp">&</text>
              <text class="pair-player-name">{{item.player2Name}}</text>
              <text class="gender-icon {{item.player2Gender === 2 ? 'gender-icon-female' : 'gender-icon-male'}}">{{item.player2Gender === 2 ? '♀' : '♂'}}</text>
            </view>
          </view>
          <view class="col-pts pts-value">{{item.points}}</view>
          <view class="col-wl">{{item.wins}}-{{item.losses}}</view>
          <view class="col-net {{item.netScore >= 0 ? 'net-positive' : 'net-negative'}}">
            {{item.netScore >= 0 ? '+' : ''}}{{item.netScore}}
          </view>
          <view class="col-rank rank-num {{item.rank <= 3 ? 'rank-top' : ''}}">{{item.rank}}</view>
        </view>
      </view>
    </block>

    <!-- 普通模式：个人排名表 -->
    <block wx:else>
      <view class="rank-table card">
        <view class="rank-header">
          <view class="col-name">参赛选手</view>
          <view class="col-wl">胜-负</view>
          <view class="col-net">净胜分</view>
          <view class="col-rank">名次</view>
        </view>
        <view class="rank-row" wx:for="{{scoreEntries}}" wx:key="memberId">
          <view class="col-name">
            <view class="name-cell">
              <image wx:if="{{item.avatar}}" class="name-avatar" src="{{item.avatar}}" mode="aspectFill" />
              <text>{{item.name}}</text>
              <text class="gender-icon {{item.gender === 2 ? 'gender-icon-female' : 'gender-icon-male'}}">{{item.gender === 2 ? '♀' : '♂'}}</text>
            </view>
          </view>
          <view class="col-wl">{{item.wins}}-{{item.losses}}</view>
          <view class="col-net {{item.netScore >= 0 ? 'net-positive' : 'net-negative'}}">
            {{item.netScore >= 0 ? '+' : ''}}{{item.netScore}}
          </view>
          <view class="col-rank rank-num {{item.rank <= 3 ? 'rank-top' : ''}}">{{item.rank}}</view>
        </view>
      </view>
    </block>

  </block>

  <!-- ===== 对阵 Tab ===== -->
  <block wx:if="{{activeTab === 'matches'}}">
    <view class="match-detail-card" wx:for="{{matchesWithNames}}" wx:key="index">
      <view class="text-xs text-hint mb-16">第 {{item.round}} 轮 · 场 {{item.court}}</view>
      <view class="flex-center">
        <!-- A队名字 -->
        <view class="text-md text-center flex-1 match-team">
          <view class="match-name-item" wx:for="{{item.teamANames}}" wx:key="name" wx:for-item="aname">
            {{aname.name}}
            <text class="gender-icon {{aname.gender === 2 ? 'gender-icon-female' : 'gender-icon-male'}}">{{aname.gender === 2 ? '♀' : '♂'}}</text>
          </view>
        </view>
        <!-- 比分 -->
        <view class="detail-score">
          <text class="text-xl text-bold {{item.winner === 'A' ? 'text-win' : ''}}">{{item.scoreA}}</text>
          <text class="text-secondary mx-16">:</text>
          <text class="text-xl text-bold {{item.winner === 'B' ? 'text-win' : ''}}">{{item.scoreB}}</text>
        </view>
        <!-- B队名字 -->
        <view class="text-md text-center flex-1 match-team">
          <view class="match-name-item" wx:for="{{item.teamBNames}}" wx:key="name" wx:for-item="bname">
            {{bname.name}}
            <text class="gender-icon {{bname.gender === 2 ? 'gender-icon-female' : 'gender-icon-male'}}">{{bname.gender === 2 ? '♀' : '♂'}}</text>
          </view>
        </view>
      </view>
      <view class="text-xs text-hint text-center mt-8" wx:if="{{item.cannonEvents.length}}">
        💥 {{item.cannonEvents.length}}次炮击
      </view>
    </view>
  </block>


  <!-- 底部按钮 -->
  <view class="footer-bar footer-two-btns">
    <button class="btn-export" bindtap="onGoHome">🏠 返回首页</button>
    <button class="btn-replay btn-brand" bindtap="onReplay">🔄 重新开炮</button>
  </view>

</view>
